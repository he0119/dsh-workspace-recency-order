{
  // 类型检查用的总工程：源码、测试与构建脚本一起看，不产出任何文件。
  //
  // Host 端（tsconfig.json）排除 src/client，Web Client 端另有 tsconfig.client.json；这里从 Host
  // 那份继承，所以只看得到不含浏览器 API 的那一半——`.test.ts` 正是这一半的测试。要碰 `window`
  // 的用例（`test/client.test.mjs`、`test/artifact.test.mjs`）是 `.mjs`，不进来。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".typecheck",
    "declaration": false,
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "tsdown.config.ts"]
}
